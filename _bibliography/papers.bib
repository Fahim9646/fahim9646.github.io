@unpublished{alfahim2026bedding,
  abbr={In prep},
  bibtex_show={true},
  title={Transmission and Attenuation of Bedding-Plane Anisotropy from Sand to Sand-Concrete Interfaces: A Discrete Element Study},
  author={Al-Fahim, Md. Abdullah and Sazzad, Md. Mahmud and Shafi, M. S. M.},
  year={2026},
  note={In preparation},
  abstract={Naturally deposited sands are inherently anisotropic, and their peak friction depends on the orientation of the sedimentary bedding plane relative to the shear direction. This study reports a matched experimental and two-dimensional DEM investigation of two sands of contrasting angularity (sub-rounded river sand, angular crushed sand) sheared against themselves and against a concrete surface of intermediate roughness at four bedding angles and three normal stresses. Contact friction and rolling resistance are calibrated once, at θ = 0°, and then frozen, so the response at θ = 15°, 30° and 45° is a genuinely blind prediction. Results are withheld until the manuscript is published.},
  keywords={Discrete element method; Inherent anisotropy; Bedding angle; Sand-concrete interface; Direct shear; Interface roughness},
  selected={true}
}

@inproceedings{alfahim2024green,
  abbr={ICCESD},
  bibtex_show={true},
  title={Hindrances in Constructing Green Buildings in {Bangladesh}: A Comprehensive Study},
  author={Al-Fahim, Md. Abdullah and Shahriar, Sifat},
  booktitle={Proceedings of the 7th International Conference on Civil Engineering for Sustainable Development (ICCESD 2024)},
  location={KUET, Khulna, Bangladesh},
  month={feb},
  year={2024},
  note={Full paper, Paper ID 710},
  pdf={ICCESD2024-green-buildings-bangladesh.pdf},
  abstract={Bangladesh, a developing country in Southeast Asia with a comparatively small contribution to climate change, is nonetheless susceptible to its adversities. This study presents a comprehensive analysis of the challenges that arise when constructing green buildings in such a setting. The research combined qualitative and quantitative methods: 160 questionnaires were distributed to experts and the general public, and 87 responses were obtained and analysed with the Analytic Hierarchy Process (AHP). The data show that public awareness, the inability of the masses to cover the high initial cost, and the lack of individual as well as organisational initiative are noteworthy hindrances. Government involvement ranked first among seven criteria (25.0%), followed by ownership of residence (23.8%) and technical difficulties (18.7%). The study offers recommendations for policymakers, stakeholders and organisations.},
  keywords={Green building; Bangladesh; Sustainable development; Climate change; Hindrances},
  preview={green-building.png},
  selected={true}
}

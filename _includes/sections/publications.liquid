<section id="publications" class="post mt-5 pt-4" style="border-top: 1px solid var(--global-divider-color);">
  <h2><a href="{{ '/publications/' | relative_url }}" style="color: inherit">publications</a></h2>

  <h3 class="mt-3" style="font-size: 1.15rem;">published</h3>
  <div class="publications">
    {% bibliography --group_by none --query @inproceedings %}
  </div>

  <h3 class="mt-4" style="font-size: 1.15rem;">in preparation</h3>
  <div class="publications">
    {% bibliography --group_by none --query @unpublished %}
  </div>
</section>
